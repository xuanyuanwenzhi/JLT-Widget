<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 圆角 -->
    <corners android:radius="16dp" />

    <!-- 背景颜色：你可以改成更透明或更深 -->
    <solid android:color="#FFF7D8" />

    <!-- 可选描边：让边缘更“像卡片” -->
    <stroke
        android:width="1dp"
        android:color="#1A000000" />
</shape>
