<?xml version="1.0" encoding="utf-8"?>
<!--
  Fortune 动画舞台：
  - 通过多层 ImageView 叠放做“竹子前景 + 卷轴 + 展开卷轴 + 文字”的效果
  - clipChildren/clipToPadding=false：允许卷轴/文字超出容器边界（负 margin / translation 才能生效）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 舞台固定尺寸：保证不同屏幕上构图一致（后续所有偏移值都以它为参照） -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="240dp"
            android:layout_height="320dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 背景层：竹子背面 -->
            <ImageView
                android:id="@+id/img_bamboo_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fortune_bamboo_back"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <!-- 卷轴“三张叠放”：靠 translation/rotation 做扇形展开的感觉（这里的数值属于视觉魔法数） -->
            <ImageView
                android:id="@+id/img_scroll_left"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="top|center_horizontal"
                android:translationX="-36dp"
                android:rotation="-15"
                android:src="@drawable/fortune_scroll"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/img_scroll_mid"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-12dp"
                android:src="@drawable/fortune_scroll"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/img_scroll_right"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="top|center_horizontal"
                android:translationX="36dp"
                android:rotation="15"
                android:src="@drawable/fortune_scroll"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <!-- 前景层：竹子正面（盖住卷轴边缘，制造“夹在竹子里”的层次感） -->
            <ImageView
                android:id="@+id/img_bamboo_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fortune_bamboo_front"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <!-- open 卷轴：展开态（默认 alpha=0，动画时淡入；fitXY 是为了“强行拉长”） -->
            <ImageView
                android:id="@+id/img_scroll_open"
                android:layout_width="240dp"
                android:layout_height="480dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-80dp"
                android:alpha="0"
                android:src="@drawable/fortune_scroll_open"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <!-- 卷轴上的文字：alpha=0 由动画控制；marginTop 是对齐卷轴视觉中心的魔法数 -->
            <TextView
                android:id="@+id/txt_fortune_on_paper"
                android:layout_width="170dp"
                android:layout_height="220dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:alpha="0"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:maxLines="12"
                android:ellipsize="end"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontWeight="900"
                android:textColor="#D48E29" />

        </FrameLayout>
    </LinearLayout>

</FrameLayout>
